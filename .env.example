PECEM_LINEUP_URL=https://sic-tos.complexodopecem.com.br/sictossite/pesquisa.aspx?WCI=relEmitirLineUpExt_002
PUPPETEER_EXECUTABLE_PATH=

# Optional licensed/authorized enrichment adapter (server-side only).
PECEM_ENRICHMENT_URL=
PECEM_ENRICHMENT_API_KEY=
PECEM_PORT_CODE=BRPEC
